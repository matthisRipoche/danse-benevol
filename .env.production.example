# Modèle du .env de production — à copier sur le VPS à côté de compose.prod.yml,
# à compléter, puis à protéger (chmod 600). Ne jamais le versionner.

# --- Hébergement (lus par compose.prod.yml) -------------------------------
SERVER_NAME=benevoles.example.fr
ACME_EMAIL=technique@example.fr
IMAGE_REPOSITORY=ghcr.io/matthisripoche/danse-benevol

# --- Application ----------------------------------------------------------
APP_NAME="Salon de la Danse — Bénévoles"
APP_ENV=production
# Générer une seule fois : docker run --rm <IMAGE_REPOSITORY>/app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://benevoles.example.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# --- Base de données (conteneur « mariadb ») ------------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=danse_benevol
DB_USERNAME=danse_benevol
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- E-mails (fournisseur SMTP) -------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=benevoles@example.fr
MAIL_FROM_NAME="${APP_NAME}"
